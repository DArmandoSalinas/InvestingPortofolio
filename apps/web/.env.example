NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# En Vercel la raíz del proyecto es apps/web.
# NEXT_PUBLIC_SITE_URL tiene que ser la dirección pública.
# NEXT_PUBLIC_API_URL tiene que ser la API pública, no localhost.
# NEXT_PUBLIC_SUPABASE_URL tiene que ser el proyecto de Supabase público.
