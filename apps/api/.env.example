SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_ANON_KEY=replace-with-anon-key
ADMIN_EMAIL=admin@estudio.local
RANK_HIGHLIGHT_MIN=70
CORS_ORIGINS=http://localhost:3000

# XAI API (Grok) - obtén tu llave en https://console.x.ai
XAI_API_KEY=

# Web Push Notifications (genera con: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@estudio.local

# URLs
SITE_URL=http://localhost:3000

# SMTP para correos (opcional en desarrollo, usa Mailpit local)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Mailpit local (solo desarrollo)
MAILPIT_URL=http://127.0.0.1:54324

# Producción: usa las URLs públicas
# SUPABASE_URL=https://tu-proyecto.supabase.co
# SITE_URL=https://tu-dominio.vercel.app
# CORS_ORIGINS=https://tu-dominio.vercel.app
